# Copy to .env locally. Never commit real values. Node 22: node --env-file=.env server.mjs
FUYAO_API_KEY=
OPENAI_API_KEY=
INVESTLENS_LLM_MODEL=gpt-4.1-mini
# A long random operator secret; used only on your private service, never on public Pages.
INVESTLENS_OPERATOR_TOKEN=
HOST=127.0.0.1
PORT=8000
INVESTLENS_STATE=.runtime
INVESTLENS_ORIGIN=http://127.0.0.1:8000
